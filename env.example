# Environment example for realtime connectors

# Redis connection (required for publishing)
REDIS_URL=redis://localhost:6379/0

# Symbols to publish or subscribe, comma-separated
SYMBOLS=BTCUSD,ETHUSD

# Provider keys (do NOT commit real keys)
POLYGON_API_KEY=
POLYGON_WS_URL=wss://socket.polygon.io/stocks
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_POLL_INTERVAL=60

NEWSAPI_KEY=
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

# Optional: database for persistence
DATABASE_URL=

# Connector config
POLL_INTERVAL=1
